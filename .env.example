# Contoh konfigurasi environment.
# Salin ke `.env.local` untuk lokal, atau isi di dashboard Vercel/Railway.

# --- Database ---
# Lokal (default): file:data/app.db — tidak perlu diisi.
# Produksi serverless (Vercel): pakai Turso.
# TURSO_DATABASE_URL="libsql://catatku-namamu.turso.io"
# TURSO_AUTH_TOKEN="token-dari-turso"
# DATABASE_URL="file:data/app.db"
# DATABASE_PATH="data/app.db"

# Paksa cookie sesi Secure (1) / non-Secure (0). Kosong = otomatis dari HTTPS.
# COOKIE_SECURE="1"

# Lewati migrasi otomatis saat runtime (mis. setelah migrasi manual ke Turso).
# SKIP_DB_MIGRATE="1"
